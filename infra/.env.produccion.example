# Copia este archivo a /opt/sionmarket/.env en el servidor y complétalo. Nunca lo subas a GitHub.

# Dominio del API (un registro DNS tipo A apuntando a la IP del servidor).
API_DOMAIN=api.sionmarket.com

# Supabase → Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
DATABASE_URL=postgresql://postgres.oqaaxsuhtpmjnwuyqkzd:TU-CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://oqaaxsuhtpmjnwuyqkzd.supabase.co

# Sitios que pueden llamar al API desde el navegador, separados por coma (tu dominio de Vercel).
CORS_ORIGINS=https://sionmarket.com,https://www.sionmarket.com

# Avisos push reales a los teléfonos.
PUSH_ENABLED=true

# Imagen publicada por GitHub Actions (latest = último cambio en main).
BACKEND_IMAGE=ghcr.io/lysmarrangel-dev/sionmarket-backend:latest
