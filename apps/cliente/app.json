{
  "expo": {
    "name": "Sionmarket",
    "slug": "sionmarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/sionmarket-icono-app.png",
    "scheme": "sionmarket",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/sionmarket-icono-app.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.sionmarket.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FB6301",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sionmarket.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FB6301",
          "image": "./assets/brand/sionmarket-isotipo-blanco.png",
          "imageWidth": 90
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sionmarket usa tu ubicaci\u00f3n para ubicar tu direcci\u00f3n de entrega."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sionmarket usa tus fotos para tu perfil y para enviarlas por el chat del pedido."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FB6301"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
