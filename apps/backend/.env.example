SUPABASE_URL=https://oqaaxsuhtpmjnwuyqkzd.supabase.co
# Solo si tu proyecto todavía firma con el "JWT secret" heredado (HS256).
# SUPABASE_JWT_SECRET=
CORS_ORIGINS=*
